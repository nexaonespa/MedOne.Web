@page "/usuarios"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using MedOne.Web.Models
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Usuarios</PageTitle>

<h3>Usuarios</h3>

@if (cargando)
{
    <p>Cargando...</p>
}
else
{
    @if (mensaje is not null)
    {
        <div class="alert alert-success">@mensaje</div>
    }
    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Invitar usuario</h5>

            <EditForm Model="nuevo" OnValidSubmit="Invitar">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Rol</label>
                        <InputSelect class="form-select" @bind-Value="nuevo.Rol">
                            <option value="">Selecciona un rol...</option>
                            <option value="@nameof(Rol.Coordinador)">Coordinador</option>
                            <option value="@nameof(Rol.Profesional)">Profesional</option>
                            <option value="@nameof(Rol.Administrador)">Administrador</option>
                        </InputSelect>
                    </div>

                    @if (nuevo.Rol == nameof(Rol.Profesional))
                    {
                        <div class="col-md-4">
                            <label class="form-label">¿Qué profesional es?</label>
                            <InputSelect class="form-select" @bind-Value="nuevo.ProfesionalId" @bind-Value:after="AlElegirProfesional">
                                <option value="">Selecciona un profesional...</option>
                                @foreach (var p in profesionales)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                    }

                    <div class="col-md-4">
                        <label class="form-label">Email (el que usará para iniciar sesión)</label>
                        <InputText class="form-control" @bind-Value="nuevo.Email" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-3" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Crear invitación")
                </button>
            </EditForm>
        </div>
    </div>

    <h5>Usuarios con acceso (@usuarios.Count)</h5>
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Profesional vinculado</th>
                <th>Acceso clínico total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in usuarios)
            {
                <tr>
                    <td>@u.Nombre @(u.Id == usuarioActualId ? "(tú)" : "")</td>
                    <td>@u.Email</td>
                    <td>@u.Rol</td>
                    <td>@(u.Profesional?.Nombre ?? "—")</td>
                    <td>@(u.AccesoClinicoTotal ? "Sí" : "No")</td>
                    <td>
                        @if (editandoId != u.Id)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EmpezarEdicion(u)">Editar</button>
                        }
                    </td>
                </tr>

                @if (editandoId == u.Id)
                {
                    <tr>
                        <td colspan="6">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-title">Editar a @u.Nombre</h6>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Rol</label>
                                            <select class="form-select" @bind="edicion.Rol" @bind:after="AlCambiarRolEdicion"
                                                    disabled="@(u.Id == usuarioActualId)">
                                                <option value="@nameof(Rol.Administrador)">Administrador</option>
                                                <option value="@nameof(Rol.Coordinador)">Coordinador</option>
                                                <option value="@nameof(Rol.Profesional)">Profesional</option>
                                            </select>
                                            @if (u.Id == usuarioActualId)
                                            {
                                                <small class="text-muted">No puedes cambiar tu propio rol.</small>
                                            }
                                        </div>

                                        @if (edicion.Rol != nameof(Rol.Coordinador))
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label">
                                                    Profesional vinculado @(edicion.Rol == nameof(Rol.Administrador) ? "(opcional)" : "")
                                                </label>
                                                <select class="form-select" @bind="edicion.ProfesionalId" @bind:after="AlCambiarProfesionalEdicion">
                                                    <option value="">Ninguno</option>
                                                    @foreach (var p in ProfesionalesDisponibles(u.Id))
                                                    {
                                                        <option value="@p.Id">@p.Nombre</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="col-md-4 d-flex align-items-end">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="accesoTotal"
                                                           @bind="edicion.AccesoClinicoTotal"
                                                           disabled="@string.IsNullOrEmpty(edicion.ProfesionalId)" />
                                                    <label class="form-check-label" for="accesoTotal">
                                                        Acceso clínico total (ver fichas de todos los pacientes)
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="mt-3">
                                        <button class="btn btn-primary me-2" @onclick="GuardarEdicion" disabled="@guardando">
                                            @(guardando ? "Guardando..." : "Guardar cambios")
                                        </button>
                                        <button class="btn btn-outline-secondary" @onclick="CancelarEdicion">Cancelar</button>
                                    </div>
                                    <small class="text-muted d-block mt-2">
                                        Los cambios se aplican cuando esa persona recarga la página o vuelve a iniciar sesión.
                                    </small>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <h5 class="mt-4">Invitaciones pendientes (@pendientes.Count)</h5>
    @if (pendientes.Count == 0)
    {
        <p class="text-muted">No hay invitaciones pendientes.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Profesional asociado</th>
                    <th>Creada</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in pendientes)
                {
                    <tr>
                        <td>@i.Email</td>
                        <td>@i.Rol</td>
                        <td>@(i.Profesional?.Nombre ?? "—")</td>
                        <td>@i.FechaCreacion.ToLocalTime().ToString("dd-MM-yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Anular(i.Id)">Anular</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<Usuario> usuarios = new();
    private List<Invitacion> pendientes = new();
    private List<Profesional> profesionales = new();
    private DatosInvitacion nuevo = new();
    private bool cargando = true;
    private bool guardando;
    private string? mensaje;
    private string? error;

    private Guid? usuarioActualId;
    private Guid? editandoId;
    private DatosEdicion edicion = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        // Solo el Administrador gestiona usuarios
        if (!user.IsInRole(nameof(Rol.Administrador)))
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }

        if (Guid.TryParse(user.FindFirst("usuario_id")?.Value, out var id))
            usuarioActualId = id;

        profesionales = await Db.Profesionales.AsNoTracking().OrderBy(p => p.Nombre).ToListAsync();
        await CargarDatos();
        cargando = false;
    }

    private async Task CargarDatos()
    {
        var clinicaId = Db.ClinicaIdActual;
        if (clinicaId is null) return;

        // La tabla Usuarios no tiene filtro automático, así que filtramos a mano
        usuarios = await Db.Usuarios
            .AsNoTracking()
            .Include(u => u.Profesional)
            .Where(u => u.ClinicaId == clinicaId)
            .OrderBy(u => u.Nombre)
            .ToListAsync();

        pendientes = await Db.Invitaciones
            .AsNoTracking()
            .Include(i => i.Profesional)
            .Where(i => !i.Aceptada)
            .OrderByDescending(i => i.FechaCreacion)
            .ToListAsync();
    }

    // ---------- Invitaciones ----------

    // Al elegir el profesional, se completa su email automáticamente
    private void AlElegirProfesional()
    {
        if (Guid.TryParse(nuevo.ProfesionalId, out var id))
        {
            var p = profesionales.FirstOrDefault(x => x.Id == id);
            if (p is not null) nuevo.Email = p.Email;
        }
    }

    private async Task Invitar()
    {
        guardando = true;
        mensaje = null;
        error = null;

        try
        {
            var clinicaId = Db.ClinicaIdActual;
            var email = nuevo.Email.Trim().ToLowerInvariant();
            var rol = Enum.Parse<Rol>(nuevo.Rol);
            Guid? profesionalId = null;

            if (rol == Rol.Profesional)
            {
                if (!Guid.TryParse(nuevo.ProfesionalId, out var pid))
                {
                    error = "Selecciona a qué profesional corresponde este usuario.";
                    return;
                }
                profesionalId = pid;

                if (await ProfesionalYaVinculado(pid, null))
                {
                    error = "Ese profesional ya tiene un usuario o una invitación pendiente.";
                    return;
                }
            }

            if (await Db.Usuarios.AnyAsync(u => u.ClinicaId == clinicaId && u.Email == email))
            {
                error = "Esa persona ya tiene acceso a tu clínica.";
                return;
            }

            if (await Db.Invitaciones.AnyAsync(i => i.Email == email && !i.Aceptada))
            {
                error = "Ya existe una invitación pendiente para ese email.";
                return;
            }

            // La clínica se asigna sola al guardar
            Db.Invitaciones.Add(new Invitacion
            {
                Email = email,
                Rol = rol,
                ProfesionalId = profesionalId
            });
            await Db.SaveChangesAsync();

            mensaje = $"Invitación creada. Avísale a {email} que inicie sesión en MedOne con ese email.";
            nuevo = new();
            await CargarDatos();
        }
        catch (Exception)
        {
            Db.ChangeTracker.Clear();
            error = "Ocurrió un error al crear la invitación. Intenta de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Anular(Guid invitacionId)
    {
        mensaje = null;
        error = null;

        try
        {
            var invitacion = await Db.Invitaciones.FirstOrDefaultAsync(i => i.Id == invitacionId && !i.Aceptada);
            if (invitacion is null) return;

            Db.Invitaciones.Remove(invitacion);
            await Db.SaveChangesAsync();

            mensaje = "Invitación anulada.";
            await CargarDatos();
        }
        catch (Exception)
        {
            Db.ChangeTracker.Clear();
            error = "No se pudo anular la invitación. Intenta de nuevo.";
        }
    }

    // ---------- Edición de usuarios ----------

    private void EmpezarEdicion(Usuario u)
    {
        mensaje = null;
        error = null;
        editandoId = u.Id;
        edicion = new DatosEdicion
        {
            Rol = u.Rol.ToString(),
            ProfesionalId = u.ProfesionalId?.ToString() ?? string.Empty,
            AccesoClinicoTotal = u.AccesoClinicoTotal
        };
    }

    private void CancelarEdicion() => editandoId = null;

    // El Coordinador no se vincula a un profesional ni tiene acceso clínico
    private void AlCambiarRolEdicion()
    {
        if (edicion.Rol == nameof(Rol.Coordinador))
        {
            edicion.ProfesionalId = string.Empty;
            edicion.AccesoClinicoTotal = false;
        }
    }

    // Sin profesional vinculado no hay acceso clínico total
    private void AlCambiarProfesionalEdicion()
    {
        if (string.IsNullOrEmpty(edicion.ProfesionalId))
            edicion.AccesoClinicoTotal = false;
    }

    // Profesionales libres, más el que ya tiene este usuario
    private IEnumerable<Profesional> ProfesionalesDisponibles(Guid usuarioId)
    {
        var ocupados = usuarios
            .Where(u => u.Id != usuarioId && u.ProfesionalId != null)
            .Select(u => u.ProfesionalId!.Value)
            .Concat(pendientes.Where(i => i.ProfesionalId != null).Select(i => i.ProfesionalId!.Value))
            .ToHashSet();

        return profesionales.Where(p => !ocupados.Contains(p.Id));
    }

    private async Task GuardarEdicion()
    {
        guardando = true;
        mensaje = null;
        error = null;

        try
        {
            var clinicaId = Db.ClinicaIdActual;
            var usuario = await Db.Usuarios.FirstOrDefaultAsync(u => u.Id == editandoId && u.ClinicaId == clinicaId);
            if (usuario is null)
            {
                error = "No se encontró el usuario.";
                return;
            }

            var rol = Enum.Parse<Rol>(edicion.Rol);
            Guid? profesionalId = Guid.TryParse(edicion.ProfesionalId, out var pid) ? pid : null;

            // Protección: nadie se quita a sí mismo el rol de Administrador
            if (usuario.Id == usuarioActualId && rol != Rol.Administrador)
            {
                error = "No puedes quitarte tu propio rol de Administrador.";
                return;
            }

            if (rol == Rol.Coordinador)
                profesionalId = null;

            if (rol == Rol.Profesional && profesionalId is null)
            {
                error = "Un usuario Profesional debe estar vinculado a un profesional.";
                return;
            }

            if (profesionalId is Guid id)
            {
                // El profesional debe existir en tu clínica (el filtro automático lo garantiza)
                if (!await Db.Profesionales.AnyAsync(p => p.Id == id))
                {
                    error = "El profesional seleccionado no existe.";
                    return;
                }

                if (await ProfesionalYaVinculado(id, usuario.Id))
                {
                    error = "Ese profesional ya está vinculado a otro usuario o a una invitación pendiente.";
                    return;
                }
            }

            usuario.Rol = rol;
            usuario.ProfesionalId = profesionalId;
            usuario.AccesoClinicoTotal = edicion.AccesoClinicoTotal && profesionalId is not null;

            await Db.SaveChangesAsync();

            mensaje = $"Usuario {usuario.Nombre} actualizado.";
            editandoId = null;
            await CargarDatos();
        }
        catch (Exception)
        {
            Db.ChangeTracker.Clear();
            error = "No se pudieron guardar los cambios. Intenta de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }

    // ¿El profesional ya está tomado por otro usuario o por una invitación pendiente?
    private async Task<bool> ProfesionalYaVinculado(Guid profesionalId, Guid? excepto)
    {
        var clinicaId = Db.ClinicaIdActual;

        return await Db.Usuarios.AnyAsync(u => u.ClinicaId == clinicaId && u.ProfesionalId == profesionalId && u.Id != excepto)
            || await Db.Invitaciones.AnyAsync(i => i.ProfesionalId == profesionalId && !i.Aceptada);
    }

    private class DatosInvitacion
    {
        [Required(ErrorMessage = "Selecciona un rol")]
        public string Rol { get; set; } = string.Empty;

        public string? ProfesionalId { get; set; }

        [Required(ErrorMessage = "Ingresa el email")]
        [EmailAddress(ErrorMessage = "El email no es válido")]
        public string Email { get; set; } = string.Empty;
    }

    private class DatosEdicion
    {
        public string Rol { get; set; } = string.Empty;
        public string ProfesionalId { get; set; } = string.Empty;
        public bool AccesoClinicoTotal { get; set; }
    }
}