@code {
    // Formulario de contacto (página estática: se envía como formulario web normal)
    [SupplyParameterFromForm(FormName = "contacto")]
    private DatosContacto? Contacto { get; set; }

    private bool enviado;

    protected override void OnInitialized() => Contacto ??= new();

    private async Task EnviarContacto()
    {
        // Campo trampa: si un robot lo completa, fingimos éxito y no guardamos nada
        if (!string.IsNullOrWhiteSpace(Contacto!.SitioWeb))
        {
            enviado = true;
            return;
        }

        Db.SolicitudesContacto.Add(new SolicitudContacto
        {
            Nombre = Contacto.Nombre.Trim(),
            Email = Contacto.Email.Trim().ToLowerInvariant(),
            Telefono = Contacto.Telefono?.Trim() ?? string.Empty,
            TipoCentro = Contacto.TipoCentro,
            Mensaje = Contacto.Mensaje.Trim(),
            AceptaContacto = Contacto.Acepta
        });
        await Db.SaveChangesAsync();
        enviado = true;
    }

    public class DatosContacto
    {
        [Required(ErrorMessage = "Ingresa tu nombre")]
        [StringLength(120)]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa tu correo")]
        [EmailAddress(ErrorMessage = "El correo no es válido")]
        [StringLength(160)]
        public string Email { get; set; } = string.Empty;

        [StringLength(40)]
        public string? Telefono { get; set; }

        [Required(ErrorMessage = "Selecciona el tipo de centro")]
        public string TipoCentro { get; set; } = string.Empty;

        [Required(ErrorMessage = "Escribe tu mensaje")]
        [StringLength(2000, ErrorMessage = "El mensaje es demasiado largo")]
        public string Mensaje { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessage = "Debes aceptar para que podamos contactarte")]
        public bool Acepta { get; set; }

        public string? SitioWeb { get; set; } // campo trampa contra robots
    }
}
