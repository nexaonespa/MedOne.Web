@inherits LayoutComponentBase
@using System.Security.Claims

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="saludo">
                        Hola, @context.User.Identity?.Name
                        @if (context.User.FindFirst(ClaimTypes.Role)?.Value is string rol)
                        {
                            <span class="rol">@NombreRol(rol)</span>
                        }
                    </span>
                    <a href="/Account/Logout">Cerrar sesión</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/Account/Login">Iniciar sesión</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string NombreRol(string rol) => rol switch
    {
        "DirectorClinico" => "Director Clínico",
        _ => rol
    };
}